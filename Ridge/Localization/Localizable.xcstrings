    },
    "battery.alerts.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后可在灵动岛查看已连接外设电量。低电与满电经瞬时通知提示，约三秒后自动收起。"
          }
        }
      }
    },
    "battery.alerts.low_threshold": {
      "extractionState": "manual",
