{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "battery.alerts.force_expand_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当任一外设电量低于设定阈值时，自动展开刘海进行视觉警告"
          }
        }
      }
    },
    "battery.alerts.force_expand_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严重低电量强制展开灵动岛"
          }
        }
      }
    },
    "battery.alerts.full_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外设电量达到 100% 时弹出灵动岛横幅，提醒及时移除充电线缆以保护电池"
          }
        }
      }
    },
    "battery.alerts.full_toggle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充满电提醒（防止过充）"
